# Base de dados (docker compose: serviço postgres)
DATABASE_URL="postgresql://agff:agff@localhost:5432/agff_logistics?schema=public"
# Base de dados usada pelos testes de integração (criada por docker/postgres/init.sql)
TEST_DATABASE_URL="postgresql://agff:agff@localhost:5432/agff_logistics_test?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# Email (dev: Mailpit em http://localhost:8025). MAIL_TRANSPORT=log escreve os emails na consola.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="MOBI LOG OS <no-reply@agff.local>"
MAIL_TRANSPORT="smtp"

# Armazenamento S3-compatible (dev: MinIO, consola em http://localhost:9001)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="agffminio"
S3_SECRET_KEY="agffminio-secret"
S3_BUCKET="agff-documents"

# Seed: Super Administrator inicial da plataforma
SEED_SUPERADMIN_EMAIL="admin@agff.local"
SEED_SUPERADMIN_PASSWORD=""
SEED_SUPERADMIN_NAME="Super Administrador"

# Protege POST /api/cron/auctions (fecho de leilões). Vazio = endpoint desactivado.
CRON_SECRET=""

# --- Piloto (Vercel) ----------------------------------------------------------
# PILOT_MODE=1 mostra o aviso "piloto fechado / pagamento por factura fora da app".
PILOT_MODE=""
# Armazenamento: com BLOB_READ_WRITE_TOKEN (Vercel Blob privado) os uploads vão directos do browser.
# STORAGE_DRIVER=s3 força MinIO/S3 mesmo com token.
BLOB_READ_WRITE_TOKEN=""
STORAGE_DRIVER=""
# OpenStreetMap. Vazio = sem pesquisa de moradas / distância em linha recta × 1,3.
# Piloto: GEOCODER_URL="https://nominatim.openstreetmap.org" (máx. 1 pedido/s) e
# ROUTING_URL="https://router.project-osrm.org" (servidor de demonstração; usar um próprio em produção).
GEOCODER_URL=""
GEOCODER_EMAIL=""
ROUTING_URL=""
NEXT_PUBLIC_MAP_TILE_URL=""
# Web Push (alertas de ofertas ao motorista). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:pilot@mobilog.ao"
