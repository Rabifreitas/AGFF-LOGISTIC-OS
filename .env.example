# Base de dados (docker compose: serviço postgres)
DATABASE_URL="postgresql://agff:agff@localhost:5432/agff_logistics?schema=public"
# Base de dados usada pelos testes de integração (criada por docker/postgres/init.sql)
TEST_DATABASE_URL="postgresql://agff:agff@localhost:5432/agff_logistics_test?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# Email (dev: Mailpit em http://localhost:8025). MAIL_TRANSPORT=log escreve os emails na consola.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AGFF Logistics OS <no-reply@agff.local>"
MAIL_TRANSPORT="smtp"

# Armazenamento S3-compatible (dev: MinIO, consola em http://localhost:9001)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="agffminio"
S3_SECRET_KEY="agffminio-secret"
S3_BUCKET="agff-documents"

# Seed: Super Administrator inicial da plataforma
SEED_SUPERADMIN_EMAIL="admin@agff.local"
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026"
SEED_SUPERADMIN_NAME="Super Administrador"
