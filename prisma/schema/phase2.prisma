// ─────────────────────────────────────────────────────────────
// FASE 2 — Operações logísticas (2A: parceiros, expedições, tracking, incidentes).
// Marketplace (MKT), Transportes (TMS), Expedições (SHP), Documentos (DMS),
// Tracking (TRK) e Incidentes. Todas com organizationId (tenant).
// ─────────────────────────────────────────────────────────────

enum PartnerType {
  TRANSPORTER
  FREIGHT_FORWARDER
  CUSTOMS_BROKER
  WAREHOUSE
  SUPPLIER
  CUSTOMER
  OTHER
  SHIPPING_LINE
  SHIP_AGENT
  AIRLINE
  RAIL_OPERATOR
  BARGE_OPERATOR
  PORT_TERMINAL
  STEVEDORE
  CONTAINER_DEPOT
  COURIER
  HEAVY_LIFT
  INSURER
  SURVEYOR
}

enum PartnerStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ShipmentStatus {
  DRAFT
  REQUESTED
  QUOTED
  BOOKED
  IN_TRANSIT
  AT_CUSTOMS
  DELIVERED
  CANCELLED
}

enum TransportMode {
  ROAD
  SEA
  AIR
  RAIL
  MULTIMODAL
  COASTAL
  INLAND_WATERWAY
  PIPELINE
}

enum LogisticsService {
  TRANSPORT
  FREIGHT_FORWARDING
  CUSTOMS_CLEARANCE
  WAREHOUSING
  STEVEDORING
  PORT_HANDLING
  CONTAINER_DEPOT
  HEAVY_LIFT
  COLD_CHAIN
  LAST_MILE
  COURIER
  PACKAGING
  CARGO_INSURANCE
  INSPECTION
  PROJECT_CARGO
  DANGEROUS_GOODS
  SHIP_AGENCY
}

enum CargoType {
  GENERAL
  CONTAINER
  DRY_BULK
  LIQUID_BULK
  BREAKBULK
  RORO
  PROJECT
  REEFER
  DANGEROUS
  LIVESTOCK
}

enum StopType {
  PICKUP
  DELIVERY
  WAYPOINT
  CUSTOMS
  PORT
  AIRPORT
  RAIL_TERMINAL
  RIVER_PORT
  WAREHOUSE
  TRANSSHIPMENT
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Partner {
  id                   String                @id @default(cuid())
  organizationId       String                @map("organization_id")
  // Organização da plataforma que representa este parceiro (quando existir)
  linkedOrganizationId String?               @map("linked_organization_id")
  type                 PartnerType
  status               PartnerStatus         @default(DRAFT)
  name                 String
  nif                  String?
  country              String                @default("AO") @db.Char(2)
  email                String?
  phone                String?
  rating               Decimal?              @db.Decimal(3, 2)
  modes                TransportMode[]       @default([])
  services             LogisticsService[]    @default([])
  notes                String?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifications        PartnerVerification[]
  quotations           Quotation[]
  shipmentsAsCustomer  Shipment[]            @relation("ShipmentCustomer")
  shipmentsAsCarrier   Shipment[]            @relation("ShipmentCarrier")
  legsAsCarrier        ShipmentLeg[]

  @@index([organizationId])
  @@map("partners")
}

model PartnerVerification {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  partnerId      String             @map("partner_id")
  kind           String
  status         VerificationStatus @default(PENDING)
  documentId     String?            @map("document_id")
  reviewedById   String?            @map("reviewed_by_id")
  reviewedAt     DateTime?          @map("reviewed_at")
  expiresAt      DateTime?          @map("expires_at")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner        Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("partner_verifications")
}

model Shipment {
  id                String             @id @default(cuid())
  organizationId    String             @map("organization_id")
  reference         String
  status            ShipmentStatus     @default(DRAFT)
  mode              TransportMode      @default(ROAD)
  incoterm          String?
  customerPartnerId String?            @map("customer_partner_id")
  carrierPartnerId  String?            @map("carrier_partner_id")
  costCenterId      String?            @map("cost_center_id")
  plannedPickupAt   DateTime?          @map("planned_pickup_at")
  plannedDeliveryAt DateTime?          @map("planned_delivery_at")
  currency          String             @default("AOA") @db.Char(3)
  declaredValue     Decimal?           @map("declared_value") @db.Decimal(20, 2)
  notes             String?
  services          LogisticsService[] @default([])
  createdById       String?            @map("created_by_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPartner   Partner?           @relation("ShipmentCustomer", fields: [customerPartnerId], references: [id], onDelete: SetNull)
  carrierPartner    Partner?           @relation("ShipmentCarrier", fields: [carrierPartnerId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  stops             ShipmentStop[]
  legs              ShipmentLeg[]
  items             ShipmentItem[]
  quotations        Quotation[]
  trackingEvents    TrackingEvent[]
  incidents         Incident[]
  documents         Document[]
  auctions          Auction[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("shipments")
}

model ShipmentStop {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  shipmentId     String       @map("shipment_id")
  sequence       Int
  type           StopType
  name           String?
  address        String
  city           String?
  country        String       @default("AO") @db.Char(2)
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  plannedAt      DateTime?    @map("planned_at")
  arrivedAt      DateTime?    @map("arrived_at")
  departedAt     DateTime?    @map("departed_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sequence])
  @@index([organizationId])
  @@map("shipment_stops")
}

/// Perna de transporte: uma expedição multimodal tem várias (ex.: camião → navio → barcaça → camião).
model ShipmentLeg {
  id                 String        @id @default(cuid())
  organizationId     String        @map("organization_id")
  shipmentId         String        @map("shipment_id")
  sequence           Int
  mode               TransportMode
  carrierPartnerId   String?       @map("carrier_partner_id")
  origin             String
  destination        String
  equipmentType      String?       @map("equipment_type")
  vehiclePlate       String?       @map("vehicle_plate")
  vesselName         String?       @map("vessel_name")
  voyageNumber       String?       @map("voyage_number")
  flightNumber       String?       @map("flight_number")
  transportDocNumber String?       @map("transport_doc_number")
  plannedDepartureAt DateTime?     @map("planned_departure_at")
  plannedArrivalAt   DateTime?     @map("planned_arrival_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment           Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierPartner     Partner?      @relation(fields: [carrierPartnerId], references: [id], onDelete: SetNull)

  @@unique([shipmentId, sequence])
  @@index([organizationId])
  @@map("shipment_legs")
}

model ShipmentItem {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  shipmentId      String       @map("shipment_id")
  description     String
  quantity        Decimal      @db.Decimal(14, 3)
  unit            String       @default("UN")
  weightKg        Decimal?     @map("weight_kg") @db.Decimal(14, 3)
  volumeM3        Decimal?     @map("volume_m3") @db.Decimal(14, 3)
  hsCode          String?      @map("hs_code")
  dangerousGoods  Boolean      @default(false) @map("dangerous_goods")
  cargoType       CargoType    @default(GENERAL) @map("cargo_type")
  containerNumber String?      @map("container_number")
  containerType   String?      @map("container_type")
  sealNumber      String?      @map("seal_number")
  unNumber        String?      @map("un_number")
  imoClass        String?      @map("imo_class")
  tempMinC        Decimal?     @map("temp_min_c") @db.Decimal(5, 1)
  tempMaxC        Decimal?     @map("temp_max_c") @db.Decimal(5, 1)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment        Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("shipment_items")
}

model Quotation {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  shipmentId     String?         @map("shipment_id")
  partnerId      String?         @map("partner_id")
  reference      String
  status         QuotationStatus @default(DRAFT)
  currency       String          @default("AOA") @db.Char(3)
  amount         Decimal?        @db.Decimal(20, 2)
  validUntil     DateTime?       @map("valid_until")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  partner        Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("quotations")
}

model Document {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  shipmentId     String?           @map("shipment_id")
  type           String
  title          String
  status         DocumentStatus    @default(DRAFT)
  currentVersion Int               @default(0) @map("current_version")
  expiresAt      DateTime?         @map("expires_at")
  reviewedById   String?           @map("reviewed_by_id")
  reviewedAt     DateTime?         @map("reviewed_at")
  reviewNotes    String?           @map("review_notes")
  createdById    String?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]

  @@index([organizationId, type])
  @@index([organizationId, expiresAt])
  @@index([organizationId, shipmentId])
  @@map("documents")
}

model DocumentVersion {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  documentId     String       @map("document_id")
  version        Int
  storageKey     String       @map("storage_key")
  fileName       String       @map("file_name")
  mimeType       String       @map("mime_type")
  sizeBytes      Int          @map("size_bytes")
  checksumSha256 String       @map("checksum_sha256")
  uploadedById   String?      @map("uploaded_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([organizationId])
  @@map("document_versions")
}

model TrackingEvent {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  shipmentId     String       @map("shipment_id")
  code           String
  description    String?
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  occurredAt     DateTime     @map("occurred_at")
  source         String       @default("MANUAL")
  reportedById   String?      @map("reported_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, shipmentId, occurredAt])
  @@map("tracking_events")
}

model Incident {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  shipmentId     String?          @map("shipment_id")
  title          String
  description    String?
  severity       IncidentSeverity @default(MEDIUM)
  status         IncidentStatus   @default(OPEN)
  reportedById   String?          @map("reported_by_id")
  resolution     String?
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("incidents")
}
